---
import { SITE_CONFIG } from '../config/site';
---

<section id="contact-banner" class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Rounded Full-Width Container with Vermilion / Ambient Gradient -->
    <div class="reveal-on-scroll relative overflow-hidden rounded-[28px] bg-gradient-to-br from-[#EB4618] via-[#C8320A] to-[#140E0C] p-8 sm:p-12 lg:p-16 text-white shadow-2xl">
      <!-- Watermark Background -->
      <div class="pointer-events-none absolute right-4 bottom-2 select-none font-mono text-[6rem] sm:text-[10rem] font-black uppercase leading-none text-black/10">
        PIYAS AHMED KHEYAL
      </div>

      <div class="relative z-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
        <!-- Left Floating White Card Form -->
        <div class="lg:col-span-6">
          <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 text-zinc-900 shadow-2xl">
            <div class="flex items-center justify-between border-b border-stone-200 pb-4">
              <div>
                <span class="font-extrabold text-lg sm:text-xl tracking-tight text-zinc-950">
                  {SITE_CONFIG.brandName}
                </span>
                <span class="block font-mono text-[10px] uppercase text-[#EB4618]">
                  // DIRECT INQUIRY DISPATCH
                </span>
              </div>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>

            <form
              action={`mailto:${SITE_CONFIG.email}`}
              method="GET"
              class="mt-6 space-y-4"
            >
              <div>
                <label class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">
                  Your Name
                </label>
                <input
                  type="text"
                  name="subject"
                  placeholder="e.g. Elena Rostova"
                  required
                  class="w-full rounded-md border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-sm text-zinc-900 focus:border-[#EB4618] focus:bg-white focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">
                  Your Work Email
                </label>
                <input
                  type="email"
                  name="email"
                  placeholder="elena@robotics-lab.com"
                  required
                  class="w-full rounded-md border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-sm text-zinc-900 focus:border-[#EB4618] focus:bg-white focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-500 mb-1">
                  Project / Simulation Scope
                </label>
                <textarea
                  name="body"
                  rows="3"
                  placeholder="Tell me about your hardware setup, Isaac Sim needs, or physical AI collaboration..."
                  required
                  class="w-full rounded-md border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-sm text-zinc-900 focus:border-[#EB4618] focus:bg-white focus:outline-none transition-colors resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-md bg-zinc-950 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-white hover:bg-[#EB4618] transition-colors"
              >
                DISPATCH MESSAGE ↗
              </button>
            </form>
          </div>
        </div>

        <!-- Right Content & Callout -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 backdrop-blur-md">
            <span class="text-white text-xs">✦</span>
            <span class="font-mono text-xs uppercase tracking-widest text-white font-semibold">
              PHYSICAL AI COLLABORATION
            </span>
          </div>

          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-[-0.03em] leading-[1.02] text-white">
            LET'S BUILD <br />
            <span class="text-white/80">INTELLIGENT</span> <br />
            ATOMS.
          </h2>

          <p class="max-w-md text-base sm:text-lg leading-relaxed text-white/90">
            Available for full-time engineering appointments, Sim-to-Real RL research projects, and specialized physical manipulator deployments.
          </p>

          <div class="pt-4 border-t border-white/20 flex flex-wrap gap-6 text-sm font-mono">
            <div>
              <span class="block text-white/60 text-[11px] uppercase">Direct Channel</span>
              <a href={`mailto:${SITE_CONFIG.email}`} class="text-white font-bold hover:underline">
                {SITE_CONFIG.email}
              </a>
            </div>
            <div>
              <span class="block text-white/60 text-[11px] uppercase">Base Station</span>
              <span class="text-white font-bold">{SITE_CONFIG.location}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
