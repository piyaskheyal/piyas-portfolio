---
import ScrollBlurReveal from './ScrollBlurReveal';
import DualImageSwitcher from './DualImageSwitcher';
import { SITE_CONFIG } from '../config/site';
---

<section id="services" class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10 bg-[#F6F6F4] dark:bg-[#0F0F0F] transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Header -->
    <div class="reveal-on-scroll space-y-4 mb-14">
      <div class="section-pill-badge">
        <span class="section-pill-star">✦</span>
        <span>CORE DISCIPLINES</span>
      </div>

      <ScrollBlurReveal
        client:visible
        primaryText="POWERFUL ROBOTICS DISCIPLINES"
        blurredText="ENGINEERED FOR EMBODIED AI."
      />
    </div>

    <!-- Service Rows (3-Column Layout separated by hairlines) -->
    <div class="divide-y divide-stone-200 dark:divide-white/10 border-y border-stone-200 dark:border-white/10">
      {SITE_CONFIG.services.map((item, idx) => (
        <div class={`reveal-on-scroll delay-${(idx % 4) + 1} grid grid-cols-1 gap-8 py-10 lg:grid-cols-12 lg:items-center`}>
          <!-- Col 1: Index Number with Orange Star -->
          <div class="lg:col-span-2 flex items-center gap-2">
            <span class="text-[#EB4618] font-bold text-lg">✦</span>
            <span class="font-mono text-xl sm:text-2xl font-extrabold text-zinc-950 dark:text-white">
              {item.index}
            </span>
          </div>

          <!-- Col 2: Title, Subtitle & 5 Capability Tags -->
          <div class="lg:col-span-6 space-y-4">
            <h3 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-zinc-950 dark:text-white">
              {item.title}
            </h3>
            <p class="text-sm sm:text-base font-semibold text-zinc-600 dark:text-zinc-400">
              {item.subtitle}
            </p>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {item.tags.map((tag) => (
                <span class="rounded-full border border-stone-300 dark:border-white/15 bg-white dark:bg-zinc-800/80 px-3 py-1 font-mono text-xs font-medium text-zinc-800 dark:text-zinc-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Col 3: Rectangular Photo with Dual-Image Switcher Control -->
          <div class="lg:col-span-4">
            <DualImageSwitcher
              client:visible
              imageA={item.imageA}
              imageB={item.imageB}
              alt={item.title}
              labelA="SIMULATION"
              labelB="TELEMETRY"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
