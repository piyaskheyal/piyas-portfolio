---
import ScrollBlurReveal from './ScrollBlurReveal';
import { SITE_CONFIG } from '../config/site';
---

<section id="process" class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10 bg-[#0F0F0F] text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Header -->
    <div class="reveal-on-scroll space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-white font-mono text-xs">
        <span class="text-[#EB4618]">✦</span>
        <span class="tracking-widest font-semibold uppercase">RIGOROUS PIPELINE</span>
      </div>

      <ScrollBlurReveal
        client:visible
        primaryText="ENGINEERING PROCESS"
        blurredText="THAT BRIDGES SIM-TO-REAL."
        className="text-white"
      />
    </div>

    <!-- 4-Column Dark Card Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {SITE_CONFIG.process.map((item, idx) => (
        <div class={`reveal-on-scroll delay-${idx + 1} relative flex flex-col justify-between rounded-xl border border-white/15 bg-[#161616] p-7 transition-all duration-300 hover:border-[#EB4618] hover:-translate-y-1`}>
          <!-- Corner Crosshairs -->
          <span class="crosshair-corner crosshair-tl text-white/30">+</span>
          <span class="crosshair-corner crosshair-tr text-white/30">+</span>
          <span class="crosshair-corner crosshair-bl text-white/30">+</span>
          <span class="crosshair-corner crosshair-br text-white/30">+</span>

          <div>
            <!-- Top Step Number & Orange Icon -->
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#EB4618]">
                PHASE // {item.step}
              </span>
              <span class="text-xl text-[#EB4618] select-none">
                {item.icon}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="mt-6 text-xl font-extrabold uppercase tracking-tight text-white">
              {item.title}
            </h3>

            <p class="mt-4 text-xs sm:text-sm leading-relaxed text-zinc-400">
              {item.desc}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-[10px] font-mono text-zinc-500 uppercase tracking-widest">
            <span>Verified Spec</span>
            <span>✦ OK</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
