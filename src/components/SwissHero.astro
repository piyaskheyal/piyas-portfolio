---
import { ArrowUpRight } from 'lucide-react';
import { SITE_CONFIG } from '../config/site';
---

<section class="relative min-h-[94vh] w-full overflow-hidden bg-gradient-to-b from-[#EB4618] via-[#E23F12] to-[#C8320A] text-white flex flex-col justify-between">
  <!-- 4x3 Exposed Grid Hairlines & Crosshairs -->
  <div class="pointer-events-none absolute inset-0 grid grid-cols-4 grid-rows-3 z-0">
    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-b border-white/[0.12] relative"></div>

    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-r border-b border-white/[0.12] relative">
      <span class="crosshair-corner crosshair-br text-white/40">+</span>
    </div>
    <div class="border-b border-white/[0.12] relative"></div>

    <div class="border-r border-white/[0.12] relative"></div>
    <div class="border-r border-white/[0.12] relative"></div>
    <div class="border-r border-white/[0.12] relative"></div>
    <div></div>
  </div>

  <!-- Giant Background Watermark: PIYAS AHMED KHEYAL across the background -->
  <div class="pointer-events-none absolute top-6 sm:top-10 inset-x-0 flex justify-center select-none overflow-hidden z-0">
    <span class="font-extrabold uppercase tracking-tight text-[clamp(4.5rem,14vw,14rem)] text-black/[0.12] leading-none whitespace-nowrap">
      {SITE_CONFIG.titleWatermark}
    </span>
  </div>

  <!-- Middle Background Subject: High-Resolution Cutout Portrait (headshot_noBG.png) -->
  <div class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 z-[1] flex items-end justify-center w-full max-w-4xl h-[75vh] sm:h-[82vh] lg:h-[88vh] overflow-hidden">
    <!-- Subtle Ambient Rim Lighting -->
    <div class="absolute inset-0 bg-radial from-white/20 via-transparent to-transparent opacity-60 blur-3xl"></div>
    
    <img
      src="/images/headshot_noBG.png"
      alt={SITE_CONFIG.name}
      class="h-full w-auto max-w-none object-contain object-bottom drop-shadow-[0_25px_60px_rgba(0,0,0,0.55)] select-none opacity-95 transition-transform duration-700 hover:scale-[1.01]"
      loading="eager"
      decoding="async"
    />
    
    <!-- Soft gradient blend at bottom edge to ground subject -->
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#C8320A] via-[#C8320A]/40 to-transparent"></div>
  </div>

  <!-- Foreground Content Layers -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 pt-8 pb-12 flex flex-col justify-between flex-1 w-full min-h-[90vh]">
    <!-- Top Row of Content -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
      <!-- Left Column: Primary Copy & Discipline Badge -->
      <div class="lg:col-span-5 space-y-4 pt-2 sm:pt-4">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-1 font-mono text-[11px] uppercase tracking-wider backdrop-blur-md">
          <span class="text-white">✦</span>
          <span>PHYSICAL AI &amp; SIMULATION</span>
        </div>

        <p class="text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase tracking-tight leading-[1.14] text-white drop-shadow-sm max-w-lg">
          "I BUILD PHYSICAL AI SYSTEMS &amp; ROBOTIC RIGS THAT BRIDGE SIMULATION AND REALITY"
        </p>

        <p class="text-xs sm:text-sm font-mono text-white/90 max-w-md pt-1 drop-shadow-xs">
          Specializing in NVIDIA Isaac Lab massively parallel RL, SO-101 teleoperation, and real-time C++ robotics firmware.
        </p>
      </div>

      <!-- Center Spacer (Allows cutout to shine in the middle) -->
      <div class="hidden lg:block lg:col-span-3"></div>

      <!-- Right Column: Floating Polaroid Project Spec Card -->
      <div class="lg:col-span-4 flex justify-end pt-2 sm:pt-4">
        <div class="relative w-full max-w-xs rounded-xl border border-white/30 bg-white p-3.5 text-zinc-900 shadow-2xl transition-transform duration-300 hover:-translate-y-1">
          <!-- 4 Corner Crosshairs -->
          <span class="crosshair-corner crosshair-tl text-zinc-400">+</span>
          <span class="crosshair-corner crosshair-tr text-zinc-400">+</span>
          <span class="crosshair-corner crosshair-bl text-zinc-400">+</span>
          <span class="crosshair-corner crosshair-br text-zinc-400">+</span>

          <!-- Card Visual / Preview Frame -->
          <div class="relative h-40 sm:h-44 w-full overflow-hidden rounded-lg bg-zinc-950">
            <img
              src="/images/profile.png"
              alt="SO-101 VLA Manipulation Rig"
              class="h-full w-full object-cover opacity-85 transition-transform duration-500 hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute top-2 left-2 rounded bg-emerald-500/90 px-1.5 py-0.5 font-mono text-[9px] font-bold text-white uppercase">
              LIVE RIG
            </div>
          </div>

          <!-- Card Footer Metadata -->
          <div class="mt-3 flex items-center justify-between border-t border-stone-200 pt-2 font-mono text-[11px] font-bold">
            <span class="text-zinc-900 flex items-center gap-1">
              <span class="text-[#EB4618]">✦</span> SO-101 VLA
            </span>
            <span class="text-zinc-500">/Robotics</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Row: FULL NAME "Piyas Ahmed Kheyal" on Bottom-Left + Floating Let's Talk Badge on Bottom-Right -->
    <div class="mt-12 pt-8 flex flex-col lg:flex-row items-end justify-between gap-6 border-t border-white/20">
      <!-- Bottom-Left: ©2026 above FULL NAME "PIYAS AHMED KHEYAL" in massive display typography -->
      <div class="w-full lg:w-auto">
        <span class="block font-mono text-xs sm:text-sm font-semibold tracking-widest text-white/80 mb-2">
          ©2026 // EMBODIED INTELLIGENCE &amp; ROBOTICS
        </span>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl xl:text-8xl font-black uppercase tracking-[-0.04em] text-white leading-[0.92] drop-shadow-md">
          PIYAS AHMED <br class="hidden sm:inline" /> KHEYAL
        </h1>
      </div>

      <!-- Bottom-Right Floating "Let's Talk" Badge (#111111) -->
      <div class="w-full lg:w-auto flex justify-end">
        <a
          href="/contact"
          class="group flex items-center gap-4 rounded-2xl border border-white/20 bg-[#111111] p-3 sm:p-4 text-white shadow-2xl transition-all duration-300 hover:border-[#EB4618] hover:scale-[1.02]"
        >
          <!-- Square portrait thumbnail with headshot_noBG -->
          <div class="h-12 w-12 sm:h-14 sm:w-14 overflow-hidden rounded-xl border border-white/20 bg-gradient-to-br from-[#EB4618] to-zinc-900 shrink-0 flex items-center justify-center">
            <img
              src="/images/headshot_noBG.png"
              alt={SITE_CONFIG.name}
              class="h-full w-full object-contain object-top"
            />
          </div>

          <!-- Center Text: Full Name & Role -->
          <div class="text-left pr-2">
            <span class="block font-mono text-[11px] font-bold uppercase tracking-wider text-[#EB4618]">
              Let's Talk
            </span>
            <span class="block text-sm sm:text-base font-bold text-white tracking-tight">
              {SITE_CONFIG.name}
            </span>
            <span class="block text-[11px] text-zinc-400 font-mono">
              Robotics &amp; Physical AI
            </span>
          </div>

          <!-- White Square ↗ Icon Button -->
          <div class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-lg bg-white text-black transition-transform duration-300 group-hover:bg-[#EB4618] group-hover:text-white group-hover:rotate-45">
            <ArrowUpRight className="h-5 w-5" />
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
