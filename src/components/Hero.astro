---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative overflow-hidden border-b border-black/[0.06] dark:border-white/[0.07] pt-12 pb-16 md:pt-16 md:pb-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left Column: Personal Narrative, Apple-Scale Display Typography & Primary CTAs -->
      <div class="space-y-6 lg:col-span-7">
        <!-- Live Status Pill (Apple Glass Chip) -->
        <div class="stagger-item stagger-1 glass-chip inline-flex items-center gap-2.5 rounded-full px-3.5 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 dark:bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.06em]">{SITE_CONFIG.status}</span>
        </div>

        <!-- Main Display Headline (Apple Optical Sizing: Tight Leading, Negative Tracking) -->
        <h1 class="stagger-item stagger-2 text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-[-0.035em] leading-[1.08] text-zinc-950 dark:text-white">
          Architecting <span class="text-emerald-600 dark:text-emerald-400">embodied intelligence</span> from Isaac Lab simulation to physical hardware.
        </h1>

        <!-- Personal Narrative Subtitle -->
        <p class="stagger-item stagger-3 text-base sm:text-lg leading-[1.6] text-zinc-600 dark:text-zinc-400 max-w-2xl">
          I’m <strong class="font-semibold text-zinc-950 dark:text-zinc-100">{SITE_CONFIG.name}</strong> — a Robotics Engineer focused on
          <span class="text-zinc-900 dark:text-zinc-200">Physical AI & VLA manipulation</span> on the SO-101 6-DoF arm,
          <span class="text-zinc-900 dark:text-zinc-200">massively parallel RL for bipedal locomotion</span> in NVIDIA Isaac Lab, and
          <span class="text-zinc-900 dark:text-zinc-200">deterministic C++ ROS 2 navigation</span>.
        </p>

        <!-- Primary Action Touchpoints -->
        <div class="stagger-item stagger-4 flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#projects"
            class="tactile-btn inline-flex items-center gap-2 rounded-xl bg-zinc-950 px-5 py-2.5 text-sm font-medium text-white hover:bg-zinc-800 dark:bg-white dark:text-surface-950 dark:hover:bg-zinc-200 shadow-sm"
          >
            <span>Explore Robotic Systems</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a
            href="#experience"
            class="tactile-btn glass-chip inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium text-zinc-800 hover:text-zinc-950 dark:text-zinc-200 dark:hover:text-white shadow-xs"
          >
            <span>Research & Journey</span>
          </a>
          <a
            href={SITE_CONFIG.socials.github}
            target="_blank"
            rel="noreferrer"
            class="tactile-btn glass-chip inline-flex items-center gap-2 rounded-xl px-3.5 py-2.5 font-mono text-xs text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
          >
            GitHub ↗
          </a>
          <a
            href={SITE_CONFIG.socials.youtube}
            target="_blank"
            rel="noreferrer"
            class="tactile-btn glass-chip inline-flex items-center gap-2 rounded-xl px-3.5 py-2.5 font-mono text-xs text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
          >
            YouTube ↗
          </a>
        </div>

        <!-- Telemetry Numbers Grid (Apple Frosted Glass Surface) -->
        <div class="stagger-item stagger-4 pt-3">
          <div class="glass-surface grid grid-cols-2 gap-3 sm:grid-cols-4 rounded-2xl p-4">
            {SITE_CONFIG.stats.map((s) => (
              <div>
                <div class="font-mono text-lg sm:text-xl font-semibold tracking-[-0.02em] text-zinc-950 dark:text-emerald-400">
                  {s.value}
                </div>
                <div class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.04em] text-zinc-500 dark:text-zinc-400">
                  {s.label}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Apple-Style Personal Engineer ID Card -->
      <div class="stagger-item stagger-3 lg:col-span-5">
        <div class="glass-surface relative overflow-hidden rounded-3xl p-4 sm:p-5 shadow-2xl transition-all duration-300">
          <!-- Card Telemetry Topbar -->
          <div class="mb-3.5 flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] pb-3 text-xs">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 tracking-[0.04em]">SYS.ID // PK-01</span>
              <span class="font-mono text-[11px] text-zinc-400 dark:text-zinc-500">// ROBOTICS RIG</span>
            </div>
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 dark:text-zinc-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>{SITE_CONFIG.location}</span>
            </div>
          </div>

          <!-- Engineer Portrait Frame -->
          <div class="group relative overflow-hidden rounded-2xl border border-black/[0.06] dark:border-white/10 bg-surface-950 shadow-inner">
            <!-- Subtle Telemetry Corner Accents -->
            <span class="pointer-events-none absolute left-3 top-3 z-10 font-mono text-[10px] text-emerald-400/60">+</span>
            <span class="pointer-events-none absolute right-3 top-3 z-10 font-mono text-[10px] text-emerald-400/60">+</span>
            <span class="pointer-events-none absolute bottom-3 left-3 z-10 font-mono text-[10px] text-emerald-400/60">+</span>
            <span class="pointer-events-none absolute bottom-3 right-3 z-10 font-mono text-[10px] text-emerald-400/60">+</span>

            <img
              src={SITE_CONFIG.avatar}
              alt={SITE_CONFIG.name}
              onerror={`this.onerror=null;this.src='${SITE_CONFIG.avatarFallback}'`}
              loading="eager"
              decoding="async"
              class="h-[340px] sm:h-[360px] w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
            />

            <!-- Bottom Floating Frosted Glass Overlay (Dynamic Island Style) -->
            <div class="absolute inset-x-2.5 bottom-2.5 rounded-xl border border-black/10 dark:border-white/15 bg-surface-900/85 dark:bg-surface-950/85 p-3 backdrop-blur-xl shadow-lg">
              <div>
                <div class="text-sm font-semibold tracking-[-0.015em] text-zinc-950 dark:text-white">
                  {SITE_CONFIG.name}
                </div>

                <!-- Disciplines (Exact user specification: No verified tag, only these 3 disciplines) -->
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <span class="inline-flex items-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-emerald-700 dark:text-emerald-300">
                    Robotics &amp; Simulation Engineering
                  </span>
                  <span class="inline-flex items-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-emerald-700 dark:text-emerald-300">
                    Physical AI
                  </span>
                  <span class="inline-flex items-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-emerald-700 dark:text-emerald-300">
                    Embedded Programming
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Telemetry Spec Row -->
          <div class="mt-3.5 grid grid-cols-2 gap-2 text-xs">
            <div class="glass-chip rounded-xl p-2.5">
              <span class="block font-mono text-[9px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                Core Lab Hardware
              </span>
              <span class="mt-0.5 block font-medium text-zinc-800 dark:text-zinc-200 text-[11px]">
                SO-101 6-DoF Arm & LiDAR
              </span>
            </div>
            <div class="glass-chip rounded-xl p-2.5">
              <span class="block font-mono text-[9px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                Simulation Engine
              </span>
              <span class="mt-0.5 block font-medium text-zinc-800 dark:text-zinc-200 text-[11px]">
                NVIDIA Isaac Lab & Sim
              </span>
            </div>
          </div>

          <!-- Card Direct Connect Action Bar -->
          <div class="mt-3.5 flex items-center justify-between border-t border-black/[0.06] dark:border-white/[0.08] pt-3">
            <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Direct Connect</span>
            <div class="flex items-center gap-2">
              <a
                href={SITE_CONFIG.socials.linkedin}
                target="_blank"
                rel="noreferrer"
                class="tactile-btn glass-chip inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-[11px] font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
              >
                LinkedIn ↗
              </a>
              <a
                href={SITE_CONFIG.socials.youtube}
                target="_blank"
                rel="noreferrer"
                class="tactile-btn glass-chip inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-[11px] font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
              >
                YouTube ↗
              </a>
              <a
                href={SITE_CONFIG.socials.github}
                target="_blank"
                rel="noreferrer"
                class="tactile-btn glass-chip inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-[11px] font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
              >
                GitHub ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>