---
import { SITE_CONFIG } from '../config/site';
---

<header class="sticky top-0 z-30 border-b border-white/[0.07] bg-surface-950/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <a href="#" class="group flex items-center gap-3 focus:outline-none">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-surface-900 font-mono text-xs font-semibold text-accent transition-colors group-hover:border-accent/40">
        PK
      </div>
      <div>
        <span class="block text-sm font-medium tracking-tight text-white">
          {SITE_CONFIG.name}
        </span>
        <span class="block font-mono text-[11px] text-zinc-400">
          PHYSICAL AI • ROBOTICS
        </span>
      </div>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex">
      <a href="#projects" class="transition-colors hover:text-white">Systems & Projects</a>
      <a href="#architecture" class="transition-colors hover:text-white">Technical Stack</a>
      <a href="#contact" class="transition-colors hover:text-white">Contact</a>
    </nav>

    <div class="flex items-center gap-2.5">
      <button
        id="open-cmd-btn"
        type="button"
        class="tactile-btn flex items-center gap-2.5 rounded-lg border border-white/10 bg-surface-900 px-3 py-1.5 text-xs text-zinc-300 hover:border-white/20 hover:text-white"
        aria-label="Open command menu"
      >
        <span>Quick Jump</span>
        <kbd class="rounded border border-white/10 bg-surface-800 px-1.5 py-0.5 font-mono text-[10px] text-zinc-400">
          ⌘K
        </kbd>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('open-cmd-btn');
  btn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-cmd-menu'));
  });
</script>