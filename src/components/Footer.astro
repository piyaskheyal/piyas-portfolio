---
import { SITE_CONFIG } from '../config/site';
---

<footer id="contact" class="border-t border-black/[0.06] dark:border-white/[0.08] bg-surface-950 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="interactive-card rounded-3xl border border-black/[0.06] dark:border-white/[0.08] bg-surface-900/90 dark:bg-surface-900/70 p-8 md:p-12 shadow-xs dark:shadow-none">
      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-center">
        <div>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-emerald-600 dark:text-emerald-400 font-medium">
            // INITIATE CONNECTION
          </span>
          <h2 class="mt-2 text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-[-0.03em] text-zinc-950 dark:text-white">
            Collaborate on Physical AI, Simulation, or Robotics R&D
          </h2>
          <p class="mt-2 max-w-xl text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            Available for research collaborations, Isaac Lab / ROS 2 simulation engineering, and embodied AI initiatives.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            id="copy-email-btn"
            data-email={SITE_CONFIG.email}
            class="tactile-btn inline-flex items-center gap-2 rounded-xl bg-zinc-950 px-5 py-2.5 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-white dark:text-surface-950 dark:hover:bg-zinc-200 shadow-sm"
          >
            <span id="copy-email-label">Copy Email: {SITE_CONFIG.email}</span>
          </button>

          <a
            href={SITE_CONFIG.socials.linkedin}
            target="_blank"
            rel="noreferrer"
            class="tactile-btn glass-chip rounded-xl px-4 py-2.5 text-xs font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-200 dark:hover:text-white"
          >
            LinkedIn ↗
          </a>
          <a
            href={SITE_CONFIG.socials.youtube}
            target="_blank"
            rel="noreferrer"
            class="tactile-btn glass-chip rounded-xl px-4 py-2.5 text-xs font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-200 dark:hover:text-white"
          >
            YouTube ↗
          </a>
          <a
            href={SITE_CONFIG.socials.github}
            target="_blank"
            rel="noreferrer"
            class="tactile-btn glass-chip rounded-xl px-4 py-2.5 text-xs font-medium text-zinc-700 hover:text-zinc-950 dark:text-zinc-200 dark:hover:text-white"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 text-xs text-zinc-500 sm:flex-row">
      <p>© {new Date().getFullYear()} {SITE_CONFIG.name}. Engineered with Astro, React & Tailwind.</p>
      <p class="font-mono">ISAAC LAB • ROS 2 • SO-101 VLA • C++ / PYTHON</p>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyLabel = document.getElementById('copy-email-label');

  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.getAttribute('data-email') || '';
    navigator.clipboard.writeText(email);
    window.dispatchEvent(
      new CustomEvent('show-toast', {
        detail: { message: `Email copied: ${email}` },
      })
    );
    if (copyLabel) {
      const original = copyLabel.textContent;
      copyLabel.textContent = '✓ Email Copied to Clipboard';
      setTimeout(() => {
        copyLabel.textContent = original;
      }, 2000);
    }
  });
</script>