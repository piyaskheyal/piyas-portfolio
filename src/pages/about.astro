---
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';
import HeaderBar from '../components/HeaderBar.astro';
import ScrollBlurReveal from '../components/ScrollBlurReveal';
import AnimatedCounter from '../components/AnimatedCounter';
import BentoShowcase from '../components/BentoShowcase.astro';
import FAQAccordion from '../components/FAQAccordion';
import ContactBanner from '../components/ContactBanner.astro';
import SwissFooter from '../components/SwissFooter.astro';
import ScrollRevealEngine from '../components/ScrollRevealEngine.astro';
import { Award, CheckCircle } from 'lucide-react';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — {SITE_CONFIG.name}</title>
    <meta name="description" content={`About ${SITE_CONFIG.name} — Robotics Engineer, Physical AI, Simulation`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#F6F6F4] dark:bg-[#0F0F0F] text-zinc-900 dark:text-zinc-100 antialiased font-sans transition-colors selection:bg-[#EB4618] selection:text-white">
    <HeaderBar currentPath="/about" />

    <main>
      <!-- Hero Section for About Page -->
      <section class="pt-16 pb-12 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-stone-200 dark:border-white/10 pb-8">
            <div>
              <span class="block font-mono text-xs uppercase tracking-widest text-[#EB4618] font-bold mb-2">
                {SITE_CONFIG.brandName}
              </span>
              <h1 class="giant-display-title text-zinc-950 dark:text-white tracking-[-0.04em]">
                ABOUT ME
              </h1>
            </div>

            <div class="font-mono text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
              <span>©2026 (SCROLL TO EXPLORE LAB DNA)</span>
            </div>
          </div>

          <!-- 5-Image Horizontal Editorial Gallery Strip -->
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            {[...Array(5)].map((_, i) => (
              <div class="relative h-48 sm:h-64 overflow-hidden rounded-xl border border-stone-300 dark:border-white/15 bg-zinc-950 group">
                <span class="crosshair-corner crosshair-tl text-white/50">+</span>
                <span class="crosshair-corner crosshair-br text-white/50">+</span>
                <img
                  src={SITE_CONFIG.avatar}
                  alt={`Lab Snapshot ${i + 1}`}
                  class="h-full w-full object-cover filter contrast-110 saturate-120 transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-2 left-2.5 font-mono text-[9px] uppercase tracking-wider text-white">
                  FRAME // 0{i + 1}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Mission & Outlined Big Counters -->
      <section class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="space-y-4 mb-14">
            <div class="section-pill-badge">
              <span class="section-pill-star">✦</span>
              <span>ENGINEERING PHILOSOPHY</span>
            </div>

            <ScrollBlurReveal
              client:visible
              primaryText="PIYAS BELIEVES EMBODIED AI"
              blurredText="DEMANDS FIRST-PRINCIPLES RIGOR."
            />
          </div>

          <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 items-center">
            <!-- Left Trust cluster -->
            <div class="lg:col-span-4 rounded-2xl border border-stone-300 dark:border-white/15 bg-white dark:bg-[#161616] p-8 shadow-sm">
              <span class="text-amber-500 text-lg">★★★★★</span>
              <h3 class="mt-3 text-2xl font-extrabold uppercase text-zinc-950 dark:text-white">
                VERIFIED HARDWARE
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Every policy trained in Isaac Lab is validated against real kinematics, thermal limits, and real-time serial bus timing.
              </p>
              <div class="mt-6 flex items-center gap-2 font-mono text-xs text-[#EB4618] font-bold">
                <CheckCircle className="h-4 w-4" />
                <span>Zero Hallucinations in Physics</span>
              </div>
            </div>

            <!-- Right 3 Outlined Numbers -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:col-span-8">
              <div class="border-b sm:border-b-0 sm:border-r border-stone-300 dark:border-white/15 pb-6 sm:pb-0 pr-4">
                <div class="font-extrabold text-5xl sm:text-6xl text-zinc-950 dark:text-white tracking-tighter">
                  <AnimatedCounter client:visible value="160" />
                </div>
                <span class="block mt-2 font-mono text-xs uppercase tracking-wider text-zinc-500">
                  Sim Iterations &amp; Envs
                </span>
              </div>

              <div class="border-b sm:border-b-0 sm:border-r border-stone-300 dark:border-white/15 pb-6 sm:pb-0 pr-4">
                <div class="font-extrabold text-5xl sm:text-6xl text-[#EB4618] tracking-tighter">
                  <AnimatedCounter client:visible value="1.5+" />
                </div>
                <span class="block mt-2 font-mono text-xs uppercase tracking-wider text-zinc-500">
                  Years of Experience
                </span>
              </div>

              <div>
                <div class="font-extrabold text-5xl sm:text-6xl text-zinc-950 dark:text-white tracking-tighter">
                  <AnimatedCounter client:visible value="80" />
                </div>
                <span class="block mt-2 font-mono text-xs uppercase tracking-wider text-zinc-500">
                  Validated Hardware Tests
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Dark Achievements Section -->
      <section class="py-16 md:py-24 bg-[#0F0F0F] text-white border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="space-y-4 mb-16">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-white font-mono text-xs">
              <span class="text-[#EB4618]">✦</span>
              <span class="tracking-widest font-semibold uppercase">HONORS &amp; RECOGNITION</span>
            </div>

            <ScrollBlurReveal
              client:visible
              primaryText="PIYAS KHEYAL®"
              blurredText="RESEARCH ACHIEVEMENTS."
              className="text-white"
            />
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {SITE_CONFIG.achievements.map((item) => (
              <div class="relative flex items-start gap-6 rounded-2xl border border-white/15 bg-[#161616] p-7 transition-all hover:border-[#EB4618]">
                <span class="crosshair-corner crosshair-tl text-white/30">+</span>
                <span class="crosshair-corner crosshair-tr text-white/30">+</span>
                <span class="crosshair-corner crosshair-bl text-white/30">+</span>
                <span class="crosshair-corner crosshair-br text-white/30">+</span>

                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-[#EB4618]">
                  <Award className="h-6 w-6" />
                </div>

                <div class="space-y-2 flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-xs font-bold text-[#EB4618]">
                      {item.year}
                    </span>
                    <span class="font-mono text-[10px] uppercase text-zinc-500">
                      {item.org}
                    </span>
                  </div>

                  <h3 class="text-lg font-extrabold uppercase tracking-tight text-white">
                    {item.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Career Journey & Checkerboard Grid -->
      <section class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="space-y-4 mb-16">
            <div class="section-pill-badge">
              <span class="section-pill-star">✦</span>
              <span>CAREER JOURNEY</span>
            </div>

            <ScrollBlurReveal
              client:visible
              primaryText="PURPOSE-DRIVEN EXPERIENCES"
              blurredText="IN ADVANCED ROBOTICS."
            />
          </div>

          <div class="space-y-6">
            {SITE_CONFIG.experience.map((exp) => (
              <div class="rounded-2xl border border-stone-300 dark:border-white/15 bg-white dark:bg-[#161616] p-8 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-stone-200 dark:border-white/10 pb-4">
                  <div>
                    <span class="font-mono text-xs font-bold uppercase text-[#EB4618]">
                      {exp.period}
                    </span>
                    <h3 class="text-xl sm:text-2xl font-extrabold uppercase text-zinc-950 dark:text-white">
                      {exp.role}
                    </h3>
                    <span class="font-mono text-xs text-zinc-500">
                      {exp.lab}
                    </span>
                  </div>

                  <div class="flex flex-wrap gap-1.5 pt-2 sm:pt-0">
                    {exp.technologies.map((t) => (
                      <span class="rounded-full bg-stone-100 dark:bg-zinc-800 px-3 py-1 font-mono text-[11px] font-semibold text-zinc-700 dark:text-zinc-300">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
                  {exp.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Bento Showcase Section -->
      <BentoShowcase />

      <!-- FAQ Accordion Section -->
      <section class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 items-start">
            <!-- Left Sticky Title -->
            <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-24">
              <div class="section-pill-badge">
                <span class="section-pill-star">✦</span>
                <span>FREQUENT QUESTIONS</span>
              </div>
              <h2 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-zinc-950 dark:text-white">
                FREQUENTLY ASKED <br />
                <span class="text-[#EB4618]">ENGINEERING</span> QUESTIONS.
              </h2>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-sm">
                Common questions about simulation architectures, Sim-to-Real convergence, and teleoperation setups.
              </p>
            </div>

            <!-- Right Numbered Accordion -->
            <div class="lg:col-span-7">
              <FAQAccordion client:visible items={SITE_CONFIG.faqs} />
            </div>
          </div>
        </div>
      </section>

      <!-- Global Contact Banner -->
      <ContactBanner />
    </main>

    <SwissFooter />
    <ScrollRevealEngine />
  </body>
</html>
