---
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';
import HeaderBar from '../components/HeaderBar.astro';
import ContactBanner from '../components/ContactBanner.astro';
import SwissFooter from '../components/SwissFooter.astro';
import ScrollRevealEngine from '../components/ScrollRevealEngine.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Research Articles & Insights — {SITE_CONFIG.name}</title>
    <meta name="description" content={`Research dispatches and technical articles by ${SITE_CONFIG.name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#F6F6F4] dark:bg-[#0F0F0F] text-zinc-900 dark:text-zinc-100 antialiased font-sans transition-colors selection:bg-[#EB4618] selection:text-white">
    <HeaderBar currentPath="/blog" />

    <main>
      <!-- Hero Section for Articles Page -->
      <section class="pt-16 pb-12 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-stone-200 dark:border-white/10 pb-8">
            <div>
              <span class="block font-mono text-xs uppercase tracking-widest text-[#EB4618] font-bold mb-2">
                {SITE_CONFIG.brandName}
              </span>
              <h1 class="giant-display-title text-zinc-950 dark:text-white tracking-[-0.04em]">
                ARTICLES
              </h1>
            </div>

            <div class="font-mono text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
              <span>©2026 // RESEARCH DISPATCHES</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 2x3 Blog Card Grid -->
      <section class="py-16 md:py-24 border-b border-stone-200 dark:border-white/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {SITE_CONFIG.articles.map((article, idx) => (
              <article class={`reveal-on-scroll delay-${(idx % 2) + 1} group relative flex flex-col justify-between rounded-2xl border border-stone-300 dark:border-white/15 bg-white dark:bg-[#161616] p-6 sm:p-8 shadow-sm transition-all hover:border-[#EB4618]`}>
                <!-- Corner Crosshairs -->
                <span class="crosshair-corner crosshair-tl text-zinc-400">+</span>
                <span class="crosshair-corner crosshair-tr text-zinc-400">+</span>
                <span class="crosshair-corner crosshair-bl text-zinc-400">+</span>
                <span class="crosshair-corner crosshair-br text-zinc-400">+</span>

                <div>
                  <!-- Category & Read time -->
                  <div class="flex items-center justify-between border-b border-stone-200 dark:border-white/10 pb-4 mb-4">
                    <span class="rounded bg-stone-100 dark:bg-zinc-800 px-2.5 py-1 font-mono text-xs font-bold uppercase text-[#EB4618]">
                      {article.category}
                    </span>
                    <span class="font-mono text-xs text-zinc-400">
                      {article.readTime}
                    </span>
                  </div>

                  <!-- 2-Line Bold Uppercase Title -->
                  <h2 class="text-xl sm:text-2xl font-extrabold uppercase tracking-tight text-zinc-950 dark:text-white group-hover:text-[#EB4618] transition-colors leading-snug">
                    {article.title}
                  </h2>

                  <!-- Square/Wide Featured Image Frame -->
                  <div class="relative mt-6 h-52 sm:h-64 w-full overflow-hidden rounded-xl bg-zinc-950">
                    <img
                      src={article.image}
                      alt={article.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  </div>

                  <!-- Summary -->
                  <p class="mt-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {article.summary}
                  </p>
                </div>

                <!-- Footer Metadata -->
                <div class="mt-8 pt-4 border-t border-stone-200 dark:border-white/10 flex items-center justify-between font-mono text-xs text-zinc-500 dark:text-zinc-400">
                  <span>Written by {article.author}</span>
                  <span class="font-bold text-[#EB4618] group-hover:translate-x-1 transition-transform">
                    {article.date} ↗
                  </span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Global Contact Banner -->
      <ContactBanner />
    </main>

    <SwissFooter />
    <ScrollRevealEngine />
  </body>
</html>
