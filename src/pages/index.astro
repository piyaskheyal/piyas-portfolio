---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { SITE_CONFIG } from '../config/site';
import HeaderBar from '../components/HeaderBar.astro';
import SwissHero from '../components/SwissHero.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import ImpactMetrics from '../components/ImpactMetrics.astro';
import ServiceList from '../components/ServiceList.astro';
import SelectedProjects from '../components/SelectedProjects.astro';
import EngineeringProcess from '../components/EngineeringProcess.astro';
import BentoShowcase from '../components/BentoShowcase.astro';
import TestimonialStrip from '../components/TestimonialStrip.astro';
import BlogPreview from '../components/BlogPreview.astro';
import ContactBanner from '../components/ContactBanner.astro';
import SwissFooter from '../components/SwissFooter.astro';
import CommandMenu from '../components/CommandMenu';
import ScrollRevealEngine from '../components/ScrollRevealEngine.astro';

const rawProjects = await getCollection('projects');
const sortedProjects = rawProjects.sort((a, b) => a.data.order - b.data.order);

const projectsForClient = await Promise.all(
  sortedProjects.map(async (entry) => {
    return {
      slug: entry.slug,
      title: entry.data.title,
      subtitle: entry.data.subtitle,
      date: entry.data.date,
      category: entry.data.category,
      simEngine: entry.data.simEngine,
      middleware: entry.data.middleware,
      hardware: entry.data.hardware,
      tags: entry.data.tags,
      metrics: entry.data.metrics,
      repoUrl: entry.data.repoUrl,
      quickCommand: entry.data.quickCommand,
      youtubeId: entry.data.youtubeId,
      architectureSteps: entry.data.architectureSteps,
      bodyHtml: entry.body
        .replace(/### (.*)/g, '<h3>$1</h3>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/^- (.*)/gm, '<li>$1</li>'),
    };
  })
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE_CONFIG.name} — {SITE_CONFIG.role}</title>
    <meta name="description" content={SITE_CONFIG.tagline} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Default to Light Mode as explicitly requested -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light'; // Default is Light Mode!
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#F6F6F4] dark:bg-[#0F0F0F] text-zinc-900 dark:text-zinc-100 antialiased font-sans transition-colors selection:bg-[#EB4618] selection:text-white">
    <!-- Solid Vermilion Sticky Header Bar with Slide-Out Drawer -->
    <HeaderBar currentPath="/" />

    <main>
      <!-- Swiss Hero Section -->
      <SwissHero />

      <!-- Marquee Strip of Tools & Engines -->
      <MarqueeStrip />

      <!-- Impact & Metrics Section -->
      <ImpactMetrics />

      <!-- Selected Research Works & Interactive Inspector Drawer -->
      <SelectedProjects projects={projectsForClient} />

      <!-- Services & Core Engineering Disciplines -->
      <ServiceList />

      <!-- 4-Step Engineering Process (Dark Cards) -->
      <EngineeringProcess />

      <!-- Why Choose Me Bento Grid -->
      <BentoShowcase />

      <!-- Peer Recommendations & Testimonials Strip -->
      <TestimonialStrip />

      <!-- Latest Research & Design Insights (Blog Preview) -->
      <BlogPreview />

      <!-- Global Contact Banner -->
      <ContactBanner />
    </main>

    <!-- Global Swiss Footer -->
    <SwissFooter />

    <!-- Universal Scroll Reveal Animation Engine -->
    <ScrollRevealEngine />

    <!-- 0ms Command Palette (⌘K) -->
    <CommandMenu
      client:load
      projects={projectsForClient.map((p) => ({
        slug: p.slug,
        title: p.title,
        category: p.category,
      }))}
    />
  </body>
</html>
